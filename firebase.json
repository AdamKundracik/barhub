{
  "database": {
    "rules": "database.rules.json"
  },
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": "8889"
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": []
    }
  ],
  "storage": {
    "rules": "storage.rules"
  }
}
